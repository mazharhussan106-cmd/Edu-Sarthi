# Copy to .env and fill in real values. This file is committed; .env is not.
#
# Prisma reads .env only — never .env.local. A DATABASE_URL in .env.local
# produces "P1012 env var not found" with no hint about which file it wanted.

# --- Database -------------------------------------------------------------
# Two URLs, two different ports, and both are required.
#
# DATABASE_URL is the transaction pooler (6543), used at runtime. Every
# serverless invocation opens its own connection; the session pooler caps at
# 15 clients and dies with EMAXCONNSESSION within seconds of real traffic.
#
# DIRECT_URL is the session pooler (5432), used by prisma migrate only. The
# transaction pooler cannot run the DDL and advisory locks migrations need.
#
# Do not use the db.xxx.supabase.co host. It has no IPv4 and will not resolve.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth -----------------------------------------------------------------
# The variable name is exactly AUTH_SECRET on NextAuth v5. Not NEXTAUTH_SECRET.
# The wrong name fails at runtime with MissingSecret, not at build.
# Generate with: npx auth secret
AUTH_SECRET="REPLACE_ME"

# Localhost is not a trusted host by default; without this, sign-in fails
# locally with UntrustedHost. Vercel sets its own host, so this is dev-only.
AUTH_TRUST_HOST=true

# --- Email ----------------------------------------------------------------
# Verification codes and password resets go through SendGrid. Leave blank in
# development — lib/email.ts logs the code to the console instead, and throws
# rather than logs in production.
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@edusarthi.com"

# --- App ------------------------------------------------------------------
# Used to build absolute links in emails. A stale value here sends password
# reset links pointing at localhost from production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage --------------------------------------------------------------
# Supabase Storage, private bucket `submissions`. Read only in lib/storage.ts,
# which is server-only.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# The service_role key, not anon. It bypasses row-level security entirely —
# never put it in a NEXT_PUBLIC_ variable or a committed file.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# --- SMS ------------------------------------------------------------------
# Off until DLT registration completes. Phone numbers are collected unverified
# while this is false.
SMS_ENABLED=false

# --- Android app (Trusted Web Activity) --------------------------------------
# Served at /.well-known/assetlinks.json. See android/README.md.
ANDROID_PACKAGE_NAME="com.edusarthi.app"
# SHA-256 of the Play app-signing key (and upload key), comma-separated.
ANDROID_CERT_SHA256=""

# --- Retention and scheduled jobs --------------------------------------------
# Recordings from finished submissions are deleted after this many days.
AUDIO_RETENTION_DAYS=90
# Vercel Cron sends this as a Bearer token to /api/cron/retention. Any long
# random string; without it the purge endpoint refuses every call.
CRON_SECRET=""
