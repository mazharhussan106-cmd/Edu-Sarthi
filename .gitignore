# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# Environment — the whole point of this file.
# .env holds the Supabase service-role key and the database password.
# .env.example is committed on purpose; it contains placeholders only.
.env
.env.*
!.env.example

# Prisma generated client
/generated
/prisma/generated

# Vercel
.vercel

# Testing
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript
*.tsbuildinfo

# Signing keys and Google credentials — kept from the repo's original
# Android .gitignore so nothing slips through if Android code lands here.
*.jks
*.keystore
google-services.json

# Local stand-in for Supabase Storage (development only)
.dev-uploads/
