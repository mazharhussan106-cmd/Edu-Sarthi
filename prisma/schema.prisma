// Owns the entire database shape for Edusarthi: auth tables, the curriculum
// (Module/Exercise), and the submission-and-audit loop (Submission/Feedback).
// It deliberately does NOT store media bytes — Submission.mediaUrl holds a
// storage key only. It also deliberately does not model progress, badges or
// certificates; those are derived from Feedback rows at read time, not stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Pooled, port 6543 — every serverless invocation opens its own connection,
  // and the session pooler's 15-client cap is gone within seconds of traffic.
  url       = env("DATABASE_URL")
  // Direct, port 5432 — migrations need DDL and advisory locks, which the
  // transaction pooler cannot run.
  directUrl = env("DIRECT_URL")
  provider  = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum MediaKind {
  AUDIO
  VIDEO
  IMAGE
}

enum SubmissionStatus {
  PENDING // uploaded, awaiting a teacher
  IN_REVIEW // a teacher has claimed it
  REVIEWED // feedback delivered
  RETURNED // sent back for a re-attempt
}

/// Why a teacher sent a submission back instead of auditing it. A fixed list,
/// not free text, so the student screen can show matching re-recording tips.
enum ReturnReason {
  BACKGROUND_NOISE
  INAUDIBLE
  WRONG_PROMPT
  INCOMPLETE
}

/// Must stay in sync with the [data-theme="…"] blocks in app/globals.css and
/// the THEMES array in lib/theme.ts. A value here with no matching CSS block
/// renders as light with no error anywhere — the failure is silent.
enum Theme {
  LIGHT
  DARK
  SEPIA
  MIDNIGHT
  HIGH_CONTRAST
}

model User {
  id                String    @id @default(cuid())
  /// What teachers see instead of the student's name, e.g. "STU-7K3Q9P".
  /// Nullable so rows created before this column existed stay valid; the
  /// backfill script fills them in.
  publicId          String?   @unique
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  phone             String?   @unique
  phoneVerified     DateTime?
  passwordHash      String?
  role              Role      @default(STUDENT)
  /// Set by an admin. A suspended account cannot sign in, and any session it
  /// already has is turned away at the next page load.
  suspendedAt       DateTime?
  suspendReason     String?
  /// "Sign out of all devices": a session whose sign-in is older than this is
  /// refused. Nullable and additive, so adding it changes no existing row.
  sessionsValidFrom DateTime?
  /// Set by an admin once a teacher is vouched for. Only verified teachers can
  /// submit decks to the public library; it is cleared if the role changes.
  teacherVerifiedAt DateTime?
  isGuest           Boolean   @default(false)
  theme             Theme     @default(LIGHT)
  preferences       Json?
  /// AI card maker. Flashcards the AI has generated for this user, ever (not
  /// per day): the free plan stops at a fixed total. Counted when generated,
  /// not when saved, because the cost is in the generating.
  aiCardsUsed       Int       @default(0)
  /// Model tokens (input + output) spent on this user's AI requests. Not used
  /// for a limit yet; kept so a token-based plan can start from real history.
  aiTokensUsed      Int       @default(0)
  /// When the person said "I am 18 or older" before their first public deck.
  /// Under-18s may not publish (owner's decision); a self-declaration, so it
  /// records what they said, not a verified age.
  adultConfirmedAt  DateTime?
  /// How their name shows on public decks. Null until the first submit asks.
  creditStyle       CreditStyle?
  /// The name they typed, used only when creditStyle is DISPLAY_NAME. An admin
  /// can clear it (Admin → Users) if it is not acceptable.
  publicName        String?

  // Student side
  submissions Submission[] @relation("StudentSubmissions")
  enrollments Enrollment[]

  // Teacher side
  reviewsGiven       Feedback[]   @relation("TeacherFeedback")
  claimedSubmissions Submission[] @relation("ClaimedSubmissions")
  aiDraftLogs        AiDraftLog[]
  aiSources          AiSource[]

  accounts          Account[]
  sessions            Session[]
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  adminActions        AdminLog[]
  cardStates          CardState[]
  reviewLogs          ReviewLog[]
  decks               Deck[]               @relation("DeckOwner")
  reviewedDecks       Deck[]               @relation("DeckReviewer")
  words               Word[]               @relation("WordOwner")
  deckReports         DeckReport[]
  deckLikes           DeckLike[]
  deckFollows         DeckFollow[]
  deckChanges         DeckChange[]
  deckMemberships     DeckMember[]         @relation("DeckMemberUser")
  deckInvitesSent     DeckMember[]         @relation("DeckMemberInviter")
  announcementDeliveries AnnouncementDelivery[]
  instituteMembership InstituteMember?
  institutesApplied   Institute[]          @relation("InstituteApplicant")
  assignedSubmissions Submission[]         @relation("AssignedSubmissions")
  notifications       Notification[]
  noticeReads         NoticeRead[]

  createdAt DateTime @default(now())
}

/// One student's attempt at one exercise.
model Submission {
  id         String           @id @default(cuid())
  studentId  String
  exerciseId String
  status     SubmissionStatus @default(PENDING)

  /// Storage key, not the file itself. A three-minute recording is 3-5 MB and
  /// would slow every query that touches this table.
  mediaUrl    String
  mediaKind   MediaKind
  /// Null for images. Drives the player UI and the timestamp validation on notes.
  durationSec Int?
  transcript  String?   @db.Text

  /// Who is currently reviewing this. Without it, two teachers can both open a
  /// PENDING submission, both write a full audit, and the second Feedback
  /// insert fails on the submissionId unique constraint — after the typing.
  claimedById String?
  claimedAt   DateTime?

  /// Set when the recording answers a card in a verified teacher's library
  /// deck: only that teacher (and admins) see it in the queue. Null means the
  /// general queue, which every teacher can claim from.
  assignedTeacherId String?

  /// Set when the recording was made from a flashcard ("Record yourself").
  wordId String?
  word   Word?   @relation(fields: [wordId], references: [id], onDelete: SetNull)

  /// Set only when status is RETURNED.
  returnReason ReturnReason?
  returnNote   String?       @db.Text
  /// The RETURNED submission this one replaces. Lets the student screen show
  /// "replaced" on the old attempt instead of asking them to re-record twice.
  retryOfId    String?       @unique
  retryOf      Submission?   @relation("Retry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retry        Submission?   @relation("Retry")

  /// When the recording was deleted under the retention policy. The row and
  /// its audit stay; only the audio or video is gone.
  mediaPurgedAt DateTime?

  student         User      @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  // No cascade: deleting an exercise students have already submitted against
  // should fail loudly, not silently erase their work.
  exercise        Exercise  @relation(fields: [exerciseId], references: [id])
  // SetNull, not Cascade: a deleted teacher account releases the claim rather
  // than deleting the student's submission.
  claimedBy       User?     @relation("ClaimedSubmissions", fields: [claimedById], references: [id], onDelete: SetNull)
  // SetNull: if the deck's teacher account is deleted the recording falls back
  // to the general queue instead of vanishing.
  assignedTeacher User?     @relation("AssignedSubmissions", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  feedback        Feedback?
  aiDraftLogs     AiDraftLog[]

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([status, createdAt]) // the teacher queue reads on this
  @@index([claimedById, status])
  @@index([assignedTeacherId, status])
  @@index([wordId])
  @@index([exerciseId])
  @@index([createdAt])
}

/// One AI draft a teacher asked for. It exists only to count: the daily limit
/// per teacher and the retry cap per submission. The draft itself is not kept
/// (the teacher edits it into the real Feedback), and the transcript lives on
/// Submission. A row is written when the draft is requested, not when it
/// succeeds, so a failing call cannot be retried without limit at our cost.
model AiDraftLog {
  id           String   @id @default(cuid())
  teacherId    String
  submissionId String
  createdAt    DateTime @default(now())

  // Cascade: the log has no meaning without either side.
  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt]) // "drafts by this teacher today"
  @@index([submissionId]) // "drafts already made for this submission"
}

/// A file (PDF or photo) a person added as a source for the AI card maker. The
/// file sits in storage only until the cards are made, or up to two days if they walk
/// away; this row is what lets both be done. It also records the type and size
/// the server accepted, so the model is never sent a file on the browser's word.
model AiSource {
  id        String   @id @default(cuid())
  userId    String
  /// Storage key under the person's own folder.
  key       String   @unique
  mediaType String
  /// The name on the person's device, shown back to them in the list. Never
  /// sent to the model.
  name      String
  sizeBytes Int
  createdAt DateTime @default(now())

  // Cascade removes the row; the file itself is removed by account deletion
  // (app/api/me) and by the daily sweep.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // "this person's live sources"
  @@index([createdAt]) // the daily sweep of abandoned ones
}

/// A teacher's audit of one submission. One-to-one with Submission.
model Feedback {
  id           String @id @default(cuid())
  submissionId String @unique
  teacherId    String

  /// Rubric scores, 0-10 each. Separate columns rather than a JSON blob so a
  /// student's trend over twenty submissions is one AVG() query instead of
  /// twenty deserialisations in application code.
  pronunciation Int
  grammar       Int
  fluency       Int
  vocabulary    Int
  confidence    Int

  summary String @db.Text
  /// Timestamped annotations: [{ at: 12.4, note: "…", severity: "minor" }]
  /// Json because the shape is a list the UI renders whole — it is never
  /// filtered, averaged or queried, which is what columns would buy.
  notes   Json?

  /// Flagged by an admin for a quality check of the audit itself.
  qaFlaggedAt DateTime?
  qaNote      String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  // No cascade: an audit outlives the teacher's account.
  teacher    User       @relation("TeacherFeedback", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@index([createdAt])
}

model Module {
  id          String     @id @default(cuid())
  /// System modules hold exercises the app creates for itself (flashcard
  /// speaking practice). They are hidden from Learn and from "next up".
  isSystem    Boolean    @default(false)
  level       Int
  title       String
  description String
  exercises   Exercise[]
}

model Exercise {
  id         String    @id @default(cuid())
  moduleId   String
  title      String
  prompt     String    @db.Text
  /// What the student is expected to submit for this exercise.
  expects    MediaKind
  /// Soft guidance shown in the UI, and validated on upload.
  minSeconds Int?
  maxSeconds Int?

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  moduleId  String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, moduleId])
}

/// Six-digit email verification code.
model VerificationCode {
  id String @id @default(cuid())

  userId     String
  /// Hashed, never stored raw. A leaked database read should not hand over a
  /// working code for an account the attacker already knows the password to.
  codeHash   String
  expiresAt  DateTime
  /// Capped at 5 in application code. Six digits is a million-guess space only
  /// if guessing is expensive.
  attempts   Int       @default(0)
  consumedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Single-use password reset token, one-hour expiry.
model PasswordResetToken {
  id String @id @default(cuid())

  userId    String
  /// The raw token only ever exists in the email. Storing the hash means a
  /// database dump cannot be replayed into account takeover.
  tokenHash String    @unique
  expiresAt DateTime
  /// Set on first use rather than deleting the row, so a second click gets
  /// "already used" instead of a confusing "invalid link".
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per failed sign-in. Read as a count over a 15-minute window.
model LoginAttempt {
  id String @id @default(cuid())

  /// Not a foreign key. Attempts are recorded even for addresses with no
  /// account, or the throttle only protects real users and probing for valid
  /// addresses stays free.
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// --- Auth.js v5 adapter tables ---------------------------------------------
// Session is unused today because the strategy is JWT, but the adapter expects
// the table to exist and Google OAuth will need Account regardless.

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Auth.js's own table for OAuth email links. Not the six-digit code above —
/// different flow, different lifetime, deliberately kept separate.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// One row per admin action: role changes, suspensions, reassignments,
/// content edits, purges. Kept so every change to someone else's account or
/// work has a name and a reason attached.
model AdminLog {
  id         String   @id @default(cuid())
  /// Null for actions the system took on its own (scheduled purges) or on a
  /// student's behalf (self-service export and deletion).
  actorId    String?
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  // SetNull: the log entry outlives the account that made it.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

/// An announcement an admin posts to every student: a class, a deadline, a
/// holiday. `eventAt` is when the thing happens (shown as "upcoming"); the
/// notice disappears at `expiresAt`, or the event time if none is set.
/// No relation to User: the author is only kept for the admin log, and a notice
/// should outlive the admin who wrote it.
model Notice {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  eventAt     DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  reads NoticeRead[]

  @@index([createdAt])
}

/// One student having seen one notice in the notification inbox. A notice is
/// for everyone, so it is not copied into each person's inbox (one notice for
/// 10,000 students would be 10,000 rows); a row exists only once someone has
/// seen it, and "unread" is the absence of one.
model NoticeRead {
  id       String   @id @default(cuid())
  userId   String
  noticeId String
  readAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([noticeId])
}

/// One thing that happened to one person, for the inbox behind the bell: an
/// audit came back, a recording was sent back, a deck was reviewed. Written
/// after the real work has committed (lib/notifications), alongside any email.
/// `kind` is text checked against NOTIFICATION_KINDS rather than an enum, so a
/// new kind needs no database change. Read items go after 90 days and unread
/// ones after 180 (owner's decision), swept by the retention cron.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String    @db.Text
  /// Always a path inside the site, checked before it is written.
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum CardKind {
  WORD
  CHUNK
  GRAMMAR
  /// Customer-support English (content/support-cards). Channel in `category`,
  /// level in `partOfSpeech`.
  SUPPORT
}

/// One flashcard: a word (and later a chunk or grammar pattern). The columns
/// here are the ones the app filters or sorts on; every other field from the
/// 56-column WordMaster sheet lives in `details`, keyed as in words.json, so a
/// new column in the sheet needs no migration.
model Word {
  id           String   @id @default(cuid())
  kind         CardKind @default(WORD)
  /// The sheet's own ID, e.g. "VRB-006". Stable across re-imports.
  code         String   @unique
  /// Learning order. For chunks this is Path A; serialB holds Path B.
  serial       Int
  /// Chunks only: the order when the student chose Path B. Null for words.
  serialB      Int?
  text         String
  partOfSpeech String?
  category     String?
  cefr         String?
  importance   Int?
  details      Json

  /// Empty until media is supplied; the card shows a placeholder.
  imageUrl String?
  audioUrl String?
  videoUrl String?

  /// Null for the built-in cards imported from the sheet — they form the
  /// official deck, so every student's existing progress stays valid.
  deckId  String?
  /// Null for built-in cards. Set to the creator for user-made cards.
  ownerId String?
  deck    Deck?   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  owner   User?   @relation("WordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// On a card in a deck's new version (working copy): the live card it came
  /// from, so approving the version updates that card and followers keep their
  /// progress. Null for a card added in the new version, and on every live card.
  liveWordId String?
  liveWord   Word?   @relation("WordVersion", fields: [liveWordId], references: [id], onDelete: SetNull)
  draftWords Word[]  @relation("WordVersion")

  states      CardState[]
  reviewLogs  ReviewLog[]
  submissions Submission[]
  changes     DeckChange[]

  /// When the card last changed. Lets two editors of a shared deck see that
  /// someone saved over the card they had open, instead of silently
  /// overwriting it. The default fills existing rows, so adding it is safe.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([deckId])
  @@index([ownerId])
  @@index([liveWordId])
  @@index([kind, serial])
  @@index([kind, serialB])
  @@index([text])
  @@index([kind, deckId, serial])
}

enum Recall {
  HARD
  MEDIUM
  EASY
}

/// One student's progress on one card: known or not, how well, when it is
/// next due, and their remarks. Created the first time they mark the card.
model CardState {
  id     String @id @default(cuid())
  userId String
  wordId String

  known          Boolean   @default(false)
  recall         Recall?
  /// Index into the review ladder (1, 3, 7, 15, 30, 60 days).
  stage          Int       @default(0)
  dueAt          DateTime
  reviews        Int       @default(0)
  lastReviewedAt DateTime?
  /// When the student first saw and marked this card; counts today's new cards.
  createdAt      DateTime  @default(now())

  // Remarks
  confident Boolean @default(false)
  important Boolean @default(false)
  favourite Boolean @default(false)
  doubt     Boolean @default(false)
  note      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, dueAt])
  @@index([wordId])
}

/// Who may see a deck. PRIVATE is the default so nothing is shared by accident.
/// One answer on one card, kept as it happened. CardState only holds the latest
/// state, so without this a student's "what did I study on Tuesday" is
/// unanswerable. Append-only: rows are never edited. History starts the day
/// this table was created; earlier reviews were already overwritten.
model ReviewLog {
  id     String  @id @default(cuid())
  userId String
  wordId String
  known  Boolean
  recall Recall?
  /// Ladder rung the card moved to by this answer.
  stage  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([wordId])
}

enum DeckVisibility {
  PRIVATE // owner only
  LINK // anyone holding the share link, view-only
  PUBLIC // listed in the library — only once APPROVED
  INSTITUTE // members of the deck's institute only; never in the public library
}

/// How a creator's name shows on their public decks. They choose it the first
/// time they submit and can change it in Settings.
enum CreditStyle {
  FULL_NAME
  FIRST_NAME
  DISPLAY_NAME
  NONE // "an EduSarthi learner"
}

/// Where a deck is in the admin review. Only a deck that asks to go PUBLIC
/// enters PENDING_REVIEW; private and link-shared decks stay DRAFT.
enum DeckStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// A collection of cards made by one user. Cards with no deck are the
/// built-in word list and are not represented here.
model Deck {
  id           String         @id @default(cuid())
  ownerId      String
  title        String
  description  String?        @db.Text
  tags         String[]
  visibility   DeckVisibility @default(PRIVATE)
  /// Random, unguessable. Set only while visibility is LINK; clearing it
  /// revokes the link.
  shareToken   String?        @unique
  status       DeckStatus     @default(DRAFT)
  /// Shown to the owner when status is REJECTED, so they know what to fix.
  rejectReason String?        @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  /// Reserved for the later Institute area. Unused and has no relation yet.
  instituteId  String?
  institute    Institute?     @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  /// How many times readers copied it from the library, for sorting. Counted,
  /// not derived, because copies are independent decks the owner cannot see.
  copyCount    Int            @default(0)
  /// The licence the owner agreed to when submitting (lib/libraryTerms). Null
  /// for decks approved before the library terms existed: no licence is shown
  /// and EduSarthi does not use them in paid features until the owner agrees.
  licence      String?
  /// Which version of the library terms they ticked, and when.
  termsVersion String?
  termsAcceptedAt DateTime?
  /// The deck this one was copied from. SetNull: deleting the original must
  /// not delete copies; sourceCredit keeps the credit line instead.
  sourceDeckId  String?
  /// "Title by Name" of the original when it was copied. CC BY-SA requires
  /// credit to survive, even after the original is gone.
  sourceCredit  String?
  /// The original's licence when copied. A copy of an EduSarthi deck may be
  /// studied, but not published or shared by link (owner's decision).
  sourceLicence String?
  /// Set on a new version (working copy) of a published deck: the live deck it
  /// will replace once an admin approves it. One at a time per deck, enforced
  /// in lib/deckVersion under a lock — not a unique constraint, because adding
  /// one makes Database setup stop on Prisma's data-loss warning.
  /// SetNull: if the live deck is deleted, the working copy is an ordinary deck.
  draftOfId     String?

  // Cascade: deleting an account removes its decks. Cards made by that user
  // inside them go with the deck.
  owner    User         @relation("DeckOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull: a deleted admin account must not delete the decks it approved.
  reviewer User?        @relation("DeckReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cards    Word[]
  reports  DeckReport[]
  likes    DeckLike[]
  follows  DeckFollow[]
  source   Deck?        @relation("DeckSource", fields: [sourceDeckId], references: [id], onDelete: SetNull)
  copies   Deck[]       @relation("DeckSource")
  draftOf  Deck?        @relation("DeckVersion", fields: [draftOfId], references: [id], onDelete: SetNull)
  drafts   Deck[]       @relation("DeckVersion")
  changes  DeckChange[]
  members  DeckMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([visibility, status]) // the library and the review queue read on this
  @@index([instituteId, visibility])
  @@index([sourceDeckId]) // deleting an original sets its copies' link to null
  @@index([draftOfId]) // "does this deck have a new version in progress?"
}

enum ReportReason {
  INAPPROPRIATE
  INCORRECT
  COPYRIGHT
  SPAM
  OTHER
}

/// A reader's report on a public deck. One per person per deck, so a single
/// account cannot hide a deck by reporting it repeatedly.
model DeckReport {
  id           String       @id @default(cuid())
  deckId       String
  reporterId   String
  reason       ReportReason
  note         String?      @db.Text
  /// Set when an admin dismisses the report or takes the deck down. Open
  /// reports (null) are what the admin queue lists.
  resolvedAt   DateTime?
  resolvedById String?

  // Cascade: reports about a deleted deck have nothing left to point at.
  deck     Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  // Cascade: a deleted account's reports go with it.
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([deckId, reporterId])
  @@index([resolvedAt, createdAt])
  @@index([reporterId])
}

/// One like per person per deck. Likes only matter on published decks, but the
/// row is kept if a deck is pulled and later republished.
/// A learner following a library deck: they study the original with their
/// own progress (CardState) and get the author's fixes, instead of copying it.
/// Removed when the author withdraws the deck or an admin takes it down.
/// What a person a deck is shared with by name may do. Editing is only ever by
/// named invite, never by link (owner's decision).
enum DeckRole {
  VIEW
  EDIT
}

/// One person a deck is shared with by name. Invited by email, so someone can
/// be invited before they have an account, and the app never says whether an
/// email has one; it becomes theirs when they accept, signed in with it.
model DeckMember {
  id          String    @id @default(cuid())
  deckId      String
  /// Lower-cased, as typed by the owner. Kept after acceptance so the owner
  /// still sees who they invited.
  email       String
  /// Null until accepted by an account with this verified email.
  userId      String?
  role        DeckRole
  invitedById String?
  acceptedAt  DateTime?
  /// An editor of a deck in the public library: when they confirmed they are
  /// 18 or older and accepted the library terms for what they add.
  termsAcceptedAt DateTime?

  deck      Deck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user      User? @relation("DeckMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: the invite outlives the inviter's account (the owner, normally).
  invitedBy User? @relation("DeckMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([deckId, email])
  @@index([email]) // "invitations for me"
  @@index([userId])
  @@index([invitedById, createdAt]) // the daily invite limit
}

/// One small fix made straight to a published deck (owner's decision: small
/// fixes go live without waiting). The admin checks it afterwards: Accept, or
/// Undo, which restores `before`. Also what the daily limits count.
model DeckChange {
  id           String    @id @default(cuid())
  deckId       String
  wordId       String
  editorId     String?
  /// Only the fields that changed: { front?, back?, example?, body? }.
  before       Json
  after        Json
  reviewedAt   DateTime?
  reviewedById String?
  /// Set when the admin undid it; the creator is told and sees a note.
  undone       Boolean   @default(false)
  undoReason   String?   @db.Text

  deck   Deck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word   Word  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  // SetNull: the fix and its record outlive the account that made it.
  editor User? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([deckId, createdAt]) // today's fixes on this deck
  @@index([reviewedAt]) // the admin's "Fixes to check"
  @@index([wordId])
  @@index([editorId])
}

model DeckFollow {
  id     String @id @default(cuid())
  userId String
  deckId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, deckId])
  @@index([deckId])
}

model DeckLike {
  id     String @id @default(cuid())
  deckId String
  userId String

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([deckId, userId])
  @@index([userId])
}

enum InstituteStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum InstituteRole {
  ADMIN
  TEACHER
  STUDENT
}

/// A school or coaching centre with its own admin, teachers and students.
/// Anyone can apply; the site admin approves. Nothing about an institute works
/// until status is APPROVED.
model Institute {
  id           String          @id @default(cuid())
  name         String
  description  String          @db.Text
  contact      String
  status       InstituteStatus @default(PENDING)
  /// Shown to the applicant when status is REJECTED or SUSPENDED.
  statusNote   String?         @db.Text
  /// What a student types to join. Rotating it stops the old one working.
  joinCode     String          @unique
  applicantId  String?
  reviewedById String?
  reviewedAt   DateTime?
  /// The approved logo shown beside the institute's name on decks it
  /// publishes. Only the site admin moves a file here, from pendingLogoKey.
  logoKey        String?
  /// Uploaded by the institute's admin and waiting for the site admin; never
  /// shown on a public page until approved.
  pendingLogoKey String?
  /// Why the site admin refused the last logo, shown to the institute's admin.
  logoNote       String?

  // Restrict: an account that applied cannot be deleted out from under its
  // institute without an admin deciding what happens to it.
  applicant User?             @relation("InstituteApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  members   InstituteMember[]
  decks     Deck[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([applicantId])
}

/// One person's place in one institute. userId is unique: a person belongs to
/// at most one institute, so "my institute" is never ambiguous.
model InstituteMember {
  id          String        @id @default(cuid())
  instituteId String
  userId      String        @unique
  role        InstituteRole @default(STUDENT)

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([instituteId, role])
}

/// An email to every account holder with a verified address — for changes the
/// Terms and Privacy pages promise to email about (owner's decision). Written
/// by an admin; the daily cron sends it in batches (lib/announcements).
model Announcement {
  id          String    @id @default(cuid())
  subject     String
  body        String    @db.Text
  /// The short line posted on students' dashboards when sending starts.
  notice      String
  createdById String?
  createdAt   DateTime  @default(now())
  /// Set when an admin starts sending; a draft until then. Only accounts
  /// created before this moment receive it.
  startedAt   DateTime?
  /// Set when everyone has been tried, or an admin stopped it.
  finishedAt  DateTime?

  deliveries AnnouncementDelivery[]

  @@index([startedAt, finishedAt])
}

/// One person's copy of an announcement. Written before the email is sent, so
/// two overlapping runs can never mail the same person twice.
model AnnouncementDelivery {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  sentAt         DateTime?
  failed         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([createdAt])
  @@index([userId])
}
